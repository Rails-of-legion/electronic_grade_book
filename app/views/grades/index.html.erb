<% if Grade.exists? %>
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
        <h1><%= t('grades.grades') %></h1>
      </div>
      <div class="row mb-4">
        <div class="col-md-9">
          <% if @grades.present? %>
          <table class="table table-sm">
            <thead>
              <tr>
                <th><%= t('grades.item') %></th>
                <th><%= t('grades.grade') %></th>
                <th><%= t('grades.student') %></th>
                <% if current_user.has_role?(:admin) %>
                  <th class="text-center"><%= t('common.actions') %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @grades.each do |grade| %>
                <tr>
                  <td><%= grade.subject.name %></td>
                  <td><%= grade.grade %></td>
                  <td><%= grade.record_book.user.name %>
                  <% if current_user.has_role?(:admin) %>
                    <td class="text-center">
                       <div>
                          <%= link_to t('common.show'), grade, class: 'btn btn-sm btn-primary', style: 'width: 120px;'%>
                       </div>
                       <div class="mt-1 mb-1">
                          <% if can? :edit, grade %>
                          <%= link_to t('common.edit'), edit_grade_path(grade), class: 'btn btn-sm btn-secondary', style: 'width: 120px;' %>
                          <% end %>
                       </div>
                       <div>
                          <% if can? :destroy, grade %>
                          <%= link_to t('common.delete'), grade_path(grade), 
                          data: {turbo_method: :delete, turbo_confirm: t('notifications.you_are_sure') }, 
                          class: 'btn btn-sm btn-danger', style: 'width: 120px;' %>
                          <% end %>
                       </div>
                   </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @total_grades > 7  %>
            <%== pagy_bootstrap_nav(@pagy) %>
          <% end %>
        <% else %>
          <p class="alert alert-info"><%= t('grades.no_grades_found') %></p>
        <% end %>
        </div>

        <div class="col-md-3">
          <%= search_form_for @q do |f| %>
                <div class="form-group mb-2">
                  <%= f.label :subject_name_cont, t('grades.item') %>
                  <%= f.collection_select :subject_id_eq, Subject.all, :id, :name, { include_blank: t('common.all') }, class: "form-control" %>
                </div>
                <div class="form-group mb-2">
                  <%= f.label :grade_eq, t('grades.grade') %>
                  <%= f.search_field :grade_eq, class: 'form-control' %>
                </div>
                <div class="form-group mb-2">
                  <%= f.label :record_book_user_last_name_cont, t('grades.students_last_name') %>
                  <%= f.search_field :record_book_user_last_name_cont, class: 'form-control' %>
                </div>
                <div class="form-group mb-3">
                  <%= f.submit t('common.search'), class: 'btn btn-primary' %>
                  <%= link_to t('common.reset'), grades_path, class: "btn btn-secondary" %>
                </div>
              </div>
          <% end %>
        </div>
      </div>
    </div>
<% else %>
  <div class="container mt-5">
    <div class="alert alert-warning" role="alert">
      <%= t('grades.no_grades_found') %>
    </div>
  </div>
<% end %>
