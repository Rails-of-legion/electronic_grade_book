 <div class="container mt-4">
  <div class="row justify-content-center">
    <div class=" col-md-10">
     <h1 class="text-center mb-3"><%= t('notifications.notification_details')%></h1>
     <div class="card shadow-sm">
       <div class="card-body">
         <p><strong><%= t('notifications.message')%> : </strong> <%= @notification.message %></p>
         <p><strong><%= t('notifications.date')%> : </strong> <%= @notification.date.strftime("%d.%m.%Y") %></p>
         <p>
            <strong><%= t('notifications.users') %> :</strong>
            <% if @users.any? %>
              <%= @users.map do |user|
                    status = @notification.notifications_users.find_by(user: user)&.status
                    status_class = status ? 'text-success' : 'text-danger'
                    status_text = status ? t('notifications.read') : t('notifications.no_read')
                    "#{user.name} <strong class='#{status_class}'>(#{status_text})</strong>"
                  end.join(', ').html_safe %>
            <% else %>
              <%= t('notifications.no_users_for_this_notification') %>
            <% end %>
          </p>
        <div class="d-flex justify-content-between">
            <div>
              <%= link_to t('common.edit'), edit_notification_path(@notification), class: "btn btn-primary mr-2" %>
              <%= link_to t('common.back'), notifications_path, class: "btn btn-secondary mr-2" %>
            </div>
            <%= link_to t('common.delete'), @notification, data: { turbo_method: :delete, turbo_confirm: t('notifications.you_are_sure') }, class: 'btn btn-danger' %>
        </div>
       </div>
     </div>
    </div>
  </div> 
</div>
