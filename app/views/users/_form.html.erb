<%= form_with(model: @user, local: true, data: { controller: "user-form" }) do |form| %>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <%= render 'shared/errors', object: @user %>
            
            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :first_name, t('users.first_name'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.text_field :first_name, class: 'form-control', placeholder: 'Иван' %>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :last_name, t('users.last_name'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.text_field :last_name, class: 'form-control', placeholder: 'Иванов' %>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :middle_name, t('users.middle_name'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.text_field :middle_name, class: 'form-control', placeholder: 'Иванович' %>
                </div>
              </div>
            </div>

           

            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :email, t('users.email'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.email_field :email, class: 'form-control', placeholder: 'ivan23123@gmail.com' %>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :password, t('users.password'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.text_field :password, class: 'form-control', placeholder: 'Пароль' %>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :password_confirmation, t('users.password_confirmation'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.text_field :password_confirmation, class: 'form-control', placeholder: 'Повторите пароль' %>
                </div>
              </div>
            </div>

            <div class="mb-3" style="display: none;">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :status, t('users.status'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.check_box :status, { checked: true }, true, false %>
                </div>
              </div>
            </div>

            

            <div class="mb-3">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :roles, t('users.role'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.collection_radio_buttons :role_ids, Role.all, :id, :name do |b| %>
                    <div class="form-check">
                      <%= b.radio_button class: "form-check-input", id: "role_#{b.value}", data: { target: "user-form.studentRoleCheckbox" } %>
                      <%= b.label class: "form-check-label", value: b.value do %>
                        <%= t("roles.#{Role.find(b.value).name}") %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="mb-3" id="group-select" data-target="user-form.groupSelect">
              <div class="row">
                <div class="col-sm-3">
                  <%= form.label :group_id, t('users.group'), class: "col-form-label" %>
                </div>
                <div class="col-sm-9">
                  <%= form.collection_select :group_id, Group.all, :id, :name, { include_blank: true }, class: "form-control" %>
                </div>
              </div>
            </div>

            <div class="text-center mt-3">
              <%= form.submit (@user.new_record? ? t('common.create') : t('common.update')), class: "btn btn-primary mr-2", data: { disable_with: (@user.new_record? ? nil : users_path) } %>
              <%= link_to t('common.back'), users_path, class: "btn btn-secondary" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div> 
<% end %>
