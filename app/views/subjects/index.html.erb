<% if Subject.exists? %>
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
        <h1><%= t('subjects.subjects') %></h1>
         <%= link_to t('common.add'), new_subject_path, class: "btn btn-primary" %>
      </div>
      <div class="row mb-4">
        <div class="col-md-9">
          <% if @subjects.present? %>
          <table class="table table-sm">
            <thead>
              <tr>
                <th class="col-md-3"><%= t('subjects.name') %></th>
                <th class="col-md-3"><%= t('subjects.hours') %></th>
                <th class="col-md-3"><%= t('subjects.units') %></th>
                <th class="col-md-2"><%= t('subjects.profiling') %></th>
                <th class="col-md-1 text-center"><%= t('subjects.actions') %></th>
              </tr>
            </thead>
           <tbody>
            <% @subjects.each do |subject| %>
              <tr>
                <td><%= subject.name %></td>
                <td><%= subject.hours %></td>
                <td><%= subject.credit_units %></td>
                <td><%= subject.profiling %></td>
                <% if current_user.has_role?(:admin) %>
                <td class="text-center">
                  <div>
                    <%= link_to t('subjects.show'), subject, class: 'btn btn-primary btn-sm', style: 'width: 120px;' %>
                  </div>
                  <div class="mb-1 mt-1">
                    <% if can? :edit, subject %>
                    <%= link_to t('common.edit'), edit_subject_path(subject), class: 'btn btn-secondary btn-sm', style: 'width: 120px;' %>
                    <% end %>
                  </div>
                  <div>
                    <% if can? :destroy, subject %>
                    <%= link_to t('common.delete'), subject_path(subject), 
                    data: { turbo_method: :delete, turbo_confirm: t('notifications.you_are_sure') }, 
                    class: 'btn btn-danger btn-sm', style: 'width: 120px;' %>
                    <% end %>
                  </div>
                </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>

          </table>
          <% if @total_subjects > 7  %>
              <%== pagy_bootstrap_nav(@pagy) %>
            <% end %>
          <% else %>
            <p class="alert alert-info"><%= t('notifications.no_notifications_found') %></p>
          <% end %>
      </div>
      <div class="col-md-3">
        <%= search_form_for @q, class: "form-inline" do |f| %>
          <div class="form-group mb-2">
            <%= f.label :name_cont, t('grades.item') %>
            <%= f.search_field :name_cont, class: "form-control" %>
          </div>
          <div class="form-group mt-3">
            <%= f.submit t('subjects.search'), class: "btn btn-primary" %>
            <%= link_to t('common.reset'), subjects_path, class: "btn btn-secondary" %> 
          </div>  
        <% end %>
      </div>
    </div>   
<% else %>
  <div class="container mt-5">
    <div class="alert alert-warning" role="alert">
      <%= t('subjects.no_subjects_found') %>
    </div>
    <% if can? :create, Subject %>
      <div class="container mt-4">
        <%= link_to t('subjects.new'), new_subject_path, class: "btn btn-primary", style: "width: 7cm; height: 38px;" %>
      </div>
    <% end %>
  </div>
<% end %>
