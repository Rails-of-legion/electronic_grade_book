<% if Specialization.exists? %>
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
        <h1><%= t('specializations.list') %></h1>
        <% if current_user.admin? %>
          <%= link_to t('common.add'), new_specialization_path, class: 'btn btn-primary' %>
        <% end %>
      </div>

      <div class="row mb-4">
        <div class="col-md-9">
        <% if @specializations.present? %>  
          <table class="table table-sm">
            <thead>
              <tr>
                <th class="col-9" ><%= t('specializations.name') %></th>
                <% if current_user.admin? %>
                  <th class="text-center col-3"><%= t('common.actions') %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @specializations.each do |specialization| %>
                <tr>
                  <td class="col-9" >(<%=(specialization.index)%>) <%= link_to specialization.name, specialization_path(specialization) %> </td>
                  <% if current_user.admin? %>
                    <td class="text-center col-3">
                      <div>
                        <%= link_to t('common.edit'), edit_specialization_path(specialization), class: 'btn btn-sm btn-secondary', style: 'width: 120px;' %>
                      <div>
                      <div class="mt-1">
                        <%= link_to t('common.delete'), specialization_path(specialization), 
                        data: { turbo_method: :delete, turbo_confirm: t('notifications.you_are_sure') }, class: 'btn btn-danger btn-sm mr', style: 'width: 120px;' %>
                    <div>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @total_specializations > 7  %>
              <%== pagy_bootstrap_nav(@pagy) %>
          <% end %>
        <% else %>
          <p class="alert alert-info"><%= t('specializations.no_specializations_found') %></p>
        <% end %>
        </div> 
        <div class="col-md-3">
          <%= search_form_for @q, class: "form-inline" do |f| %>
            <div class="form-group mb-2">
              <%= f.label :name_cont, t('specializations.name') %>
              <%= f.search_field :name_cont, class: "form-control" %>
            </div>
            <div class="form-group mt-3">
              <%= f.submit t('common.search'), class: 'btn btn-primary' %>
              <%= link_to t('common.reset'), specializations_path, class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
<% else %>
  <div class="container mt-5">
    <div class="alert alert-warning" role="alert">
      <%= t ('specializations.no_specializations_found')%>
    </div>
    <% if can? :create, Specialization %>
      <div class="container mt-4">
        <%= link_to t('specializations.create_specialization'), new_specialization_path, class: "btn btn-primary", style: "width: 7cm; height: 38px;" %>
      </div>
    <% end %>
  </div>
<% end %>
